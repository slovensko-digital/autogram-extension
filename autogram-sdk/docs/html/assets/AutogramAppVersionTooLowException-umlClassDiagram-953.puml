@startuml
skinparam ClassFontStyle bold
skinparam ClassBackgroundColor ffffff
skinparam ClassBorderColor 5a0000
skinparam RoundCorner 0
skinparam ClassBorderThickness 2
hide empty fields
hide empty methods
skinparam Shadowing true
skinparam BackgroundColor transparent
class "AutogramAppVersionTooLowException" {
    +<b>code</b> : AutogramErrorCode
    +<b>detectedVersion</b> : string
    +<b>requiredVersion</b> : string
    {static} +fromJSON(data: unknown) : AutogramError
    {static} +is(e: unknown, code: AutogramErrorCode) : e is AutogramError
    +toJSON() : SerializedAutogramError
}
class "AutogramSdkException" {
    +<b>code</b> : AutogramErrorCode
    {static} +fromJSON(data: unknown) : AutogramError
    {static} +is(e: unknown, code: AutogramErrorCode) : e is AutogramError
    +toJSON() : SerializedAutogramError
}
"AutogramSdkException" <|-- "AutogramAppVersionTooLowException"
@enduml